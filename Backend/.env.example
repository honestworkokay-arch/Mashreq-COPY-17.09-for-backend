# PostgreSQL
DB_NAME=mashreq
DB_USER=mashreq
DB_PASSWORD=replace-with-a-long-database-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mashreq

# Server-side secret used only for one-time-code hashing.
OTP_PEPPER=replace-with-at-least-32-random-characters

# console = writes delivery status only; live = actually sends email/SMS.
DELIVERY_MODE=console
ALLOW_DEBUG_OTP=false

# SMTP / email. Never commit a real app password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM="Mashreq App <no-reply@example.com>"
SMTP_STARTTLS=true

# Twilio SMS
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+10000000000
TWILIO_MESSAGING_SERVICE_SID=
